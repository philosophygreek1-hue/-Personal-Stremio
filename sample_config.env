# ─────────────────────────────────────────────────
#  Personal Stremio Addon — Railway Config
#  Fill these in Railway → Variables tab
# ─────────────────────────────────────────────────

# Telegram Bot (get API_ID & API_HASH from https://my.telegram.org)
API_ID="YOUR_API_ID"
API_HASH="YOUR_API_HASH"

# Your bot token (already set!)
BOT_TOKEN="8100323821:AAEqv_eDRfmIFLsMk_4KzxgsHlEIudOPrxA"

# A second helper bot token (create one more bot via @BotFather)
HELPER_BOT_TOKEN="YOUR_SECOND_BOT_TOKEN"

# Your Telegram user ID (get from @userinfobot)
OWNER_ID="YOUR_TELEGRAM_USER_ID"

# Your channel ID
# From URL: https://web.telegram.org/k/?account=2#-4480414116
# Channel ID = -1004480414116  (prepend -100 to the number after #)
AUTH_CHANNEL="-1004480414116"

# MongoDB — create free cluster at https://mongodb.com/atlas
# You need TWO MongoDB URIs (one tracking, one storage)
DATABASE="mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?appName=Cluster0,mongodb+srv://user:pass@cluster1.xxxxx.mongodb.net/?appName=Cluster1"

# Your Railway public URL (set after first deploy)
BASE_URL="https://your-app.railway.app"
PORT="8000"

# Admin panel login
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="your_secure_password"

# Default folder for files without a folder tag
DEFAULT_FOLDER="General"

# Parallel download streams
PARALLEL="4"
PRE_FETCH="3"

# Leave these unless you fork
UPSTREAM_REPO="https://github.com/YOUR_USERNAME/Personal-Stremio"
UPSTREAM_BRANCH="master"

# Subscription system (set false to disable)
SUBSCRIPTION="false"
SUBSCRIPTION_GROUP_ID=
APPROVER_IDS=
SUBSCRIPTION_URL=""

# Proxy (optional)
Proxy="false"
